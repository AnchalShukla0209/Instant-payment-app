<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <security>
      <requestFiltering removeServerHeader="true" />
    </security>
    <rewrite>
      <rules>
        <rule name="HTTP to HTTPS redirect" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" redirectType="Permanent" url="https://{HTTP_HOST}/{R:1}" />
        </rule>
        <rule name="AngularSPA" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
      <outboundRules>
        <preConditions>
          <preCondition name="AllResponses" logicalGrouping="MatchAny">
            <add input="{RESPONSE_STATUS}" pattern=".*" />
          </preCondition>
        </preConditions>
        <rule name="Remove Server Banner" preCondition="AllResponses">
          <match serverVariable="RESPONSE_SERVER" pattern=".+" />
          <action type="Rewrite" value="" />
        </rule>
        <rule name="Remove X-Powered-By" preCondition="AllResponses">
          <match serverVariable="RESPONSE_X-Powered-By" pattern=".+" />
          <action type="Rewrite" value="" />
        </rule>
        <rule name="Remove X-Powered-By Second Pass" preCondition="AllResponses">
          <match serverVariable="RESPONSE_X_Powered_By" pattern=".+" />
          <action type="Rewrite" value="" />
        </rule>
        <rule name="Remove X-AspNet-Version" preCondition="AllResponses">
          <match serverVariable="RESPONSE_X-AspNet-Version" pattern=".+" />
          <action type="Rewrite" value="" />
        </rule>
        <rule name="Remove X-AspNetMvc-Version" preCondition="AllResponses">
          <match serverVariable="RESPONSE_X-AspNetMvc-Version" pattern=".+" />
          <action type="Rewrite" value="" />
        </rule>
        <rule name="Remove Date Header" preCondition="AllResponses">
          <match serverVariable="RESPONSE_DATE" pattern=".+" />
          <action type="Rewrite" value="" />
        </rule>
        <rule name="Remove Vary Header" preCondition="AllResponses">
          <match serverVariable="RESPONSE_VARY" pattern=".+" />
          <action type="Rewrite" value="" />
        </rule>
        <rule name="Remove X-Generator" preCondition="AllResponses">
          <match serverVariable="RESPONSE_X-Generator" pattern=".+" />
          <action type="Rewrite" value="" />
        </rule>
      </outboundRules>
    </rewrite>
    <staticContent>
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".ttf" />
      <mimeMap fileExtension=".ttf" mimeType="font/ttf" />
      <remove fileExtension=".eot" />
      <mimeMap fileExtension=".eot" mimeType="application/vnd.ms-fontobject" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <remove name="Server" />
        <remove name="X-Powered-By" />
        <remove name="X-AspNet-Version" />
        <remove name="X-AspNetMvc-Version" />
        <remove name="X-Generator" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains; preload" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="geolocation=(self), camera=(self), microphone=()" />
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'unsafe-inline' https://checkout.razorpay.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' https://instantpayment.co.in https://api.instantpayment.co.in https://testapi-ip.thedemo.co.in https://api.razorpay.com https://lumberjack.razorpay.com https://liveapi.in https://127.0.0.1:*; frame-src https://api.razorpay.com https://checkout.razorpay.com https://qrstuff.me https://instantpayment.co.in; frame-ancestors 'self'; worker-src blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://checkout.razorpay.com; upgrade-insecure-requests" />
        <add name="Cache-Control" value="no-store, no-cache, must-revalidate" />
        <add name="Pragma" value="no-cache" />
        <add name="Expires" value="0" />
      </customHeaders>
    </httpProtocol>
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <!-- Remove defaults so custom entries take effect -->
      <remove statusCode="400" />
      <remove statusCode="401" />
      <remove statusCode="403" />
      <remove statusCode="404" />
      <remove statusCode="405" />
      <remove statusCode="406" />
      <remove statusCode="408" />
      <remove statusCode="409" />
      <remove statusCode="410" />
      <remove statusCode="412" />
      <remove statusCode="413" />
      <remove statusCode="414" />
      <remove statusCode="415" />
      <remove statusCode="416" />
      <remove statusCode="423" />
      <remove statusCode="429" />
      <remove statusCode="500" />
      <remove statusCode="501" />
      <remove statusCode="502" />
      <remove statusCode="503" />
      <remove statusCode="504" />
      <remove statusCode="505" />
      <!-- 4xx Client Errors -->
      <error statusCode="400" responseMode="Redirect" path="/bad-request" />
      <error statusCode="401" responseMode="Redirect" path="/login" />
      <error statusCode="403" responseMode="Redirect" path="/forbidden" />
      <error statusCode="404" responseMode="Redirect" path="/not-found" />
      <error statusCode="405" responseMode="Redirect" path="/method-not-allowed" />
      <error statusCode="406" responseMode="Redirect" path="/not-acceptable" />
      <error statusCode="408" responseMode="Redirect" path="/request-timeout" />
      <error statusCode="409" responseMode="Redirect" path="/conflict" />
      <error statusCode="410" responseMode="Redirect" path="/gone" />
      <error statusCode="412" responseMode="Redirect" path="/precondition-failed" />
      <error statusCode="413" responseMode="Redirect" path="/payload-too-large" />
      <error statusCode="414" responseMode="Redirect" path="/uri-too-long" />
      <error statusCode="415" responseMode="Redirect" path="/unsupported-media" />
      <error statusCode="416" responseMode="Redirect" path="/range-not-satisfiable" />
      <error statusCode="423" responseMode="Redirect" path="/account-locked" />
      <error statusCode="429" responseMode="Redirect" path="/too-many-requests" />
      <!-- 5xx Server Errors -->
      <error statusCode="500" responseMode="Redirect" path="/server-error" />
      <error statusCode="501" responseMode="Redirect" path="/not-implemented" />
      <error statusCode="502" responseMode="Redirect" path="/bad-gateway" />
      <error statusCode="503" responseMode="Redirect" path="/maintenance" />
      <error statusCode="504" responseMode="Redirect" path="/gateway-timeout" />
      <error statusCode="505" responseMode="Redirect" path="/version-not-supported" />
    </httpErrors>
  </system.webServer>
</configuration>
